# Copy to .env and fill in. Never commit .env.

# Resend (https://resend.com/api-keys). Use a key with "Full access" so it can
# send emails, manage contacts and create broadcasts.
RESEND_API_KEY=

# Resend → Audience → Segments: the segment that holds your subscribers.
RESEND_SEGMENT_ID=

# Sender. The domain must be verified in Resend (Domains → Add domain).
FROM_EMAIL="Seed & Source <hello@seedandsource.com>"

# Where reader replies go (your own inbox).
REPLY_TO=you@example.com

# Test emails from `npm run preview` go only here.
EDITOR_EMAIL=you@example.com

# Public site URL (Cloudflare Pages), used in emails and the archive.
SITE_URL=https://seedandsource.com

# US anti-spam law (CAN-SPAM) requires a physical mailing address in every
# newsletter email. A PO box or a virtual mailbox is fine.
MAILING_ADDRESS="Seed & Source, PO Box 000, City, Country"
